cabal-version:      3.4
name:               haskell-halogen-material
version:            0.2.0.0
synopsis:           Google Material Components for haskell-halogen-core
homepage:           https://github.com/Swordlash/haskell-halogen
license:            Apache-2.0
license-file:       LICENSE
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md

flag interactive
    description: Build the browser test suite for browser GHCi (toolchain/dev-test.sh)
    default:     False
    manual:      True

common warnings
    ghc-options: -Wall -Wextra -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates -Wredundant-constraints -Wmissing-home-modules -Wmissing-export-lists -Wno-ambiguous-fields
    default-extensions:
        OverloadedStrings
        CPP
        StrictData
        DuplicateRecordFields
        NoFieldSelectors
        OverloadedRecordDot
        RecordWildCards
        NamedFieldPuns
        NoImplicitPrelude
        RequiredTypeArguments
        TypeAbstractions
    build-depends:
        base,
        protolude,
        unliftio,
        text,
        containers,
        haskell-halogen-core,
        clay,
        row-types,
        extra,
        uuid-types

    if arch(wasm32)
        build-depends: ghc-experimental

library
    import:           warnings
    exposed-modules:
        Halogen.Material.Button
        Halogen.Material.Checkbox
        Halogen.Material.Icons
        Halogen.Material.List
        Halogen.Material.Monad
        Halogen.Material.RadioButton
        Halogen.Material.Tabs
        Halogen.Material.TextField
    hs-source-dirs:   src
    default-language: GHC2024

    if arch(javascript)
        js-sources: jsbits/material.js

-- Runs in headless Chromium: the wasm binary is a reactor that the browser
-- test runner loads into a page with the components' JavaScript and CSS (see
-- test/web/bundle.sh and hspec-halogen); on the JavaScript backend the same
-- runner bundles the program, components' imports and all, for the page.
-- Natively it builds, for the language server, and reports that it skipped.
test-suite Halogen-material-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Test.hs
    other-modules:    Test.Tabs
                      Test.TextField
    default-language: GHC2024
    build-depends:
        haskell-halogen-material,
        hspec-halogen,
        hspec

    if arch(wasm32) && !flag(interactive)
        ghc-options:
            -no-hs-main
            -optl-mexec-model=reactor
            "-optl-Wl,--export=hs_start"

    if flag(interactive)
        cpp-options: -DINTERACTIVE

source-repository head
  type:     git
  location: https://github.com/Swordlash/haskell-halogen.git
  subdir:   material
