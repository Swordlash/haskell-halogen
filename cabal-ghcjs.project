import: cabal.project

allow-newer:
  *:base, *:template-haskell, protolude:ghc-prim

-- Hackage as of master's last green JS build: constraints 0.13.4, out
-- since, exports a name spelled forall, which the JavaScript GHC (9.12)
-- does not parse (and pinning constraints alone drags aeson back to 0.8).
index-state: 2026-09-27T00:00:00Z

-- -ddisable-js-c-sources has to apply to every package, not just the library
-- that declares js-sources: the executables are separate packages here, and
-- their link step is what invokes emcc.
package *
  ghc-options: -O2 -fexpose-all-unfoldings -fspecialise-aggressively -ddisable-js-c-sources

-- What compiling core costs on this backend, measured on a CI runner
-- (16 GB): the compiler's process grows with every module that has a splice
-- (core has about forty: the Web types' fields, the browser bindings, the
-- element rows), by some 390 MB each, which it keeps to the end of the
-- package: 4.3 GB at module 36, 9.6 GB at 59, 14.1 GB at 90, with 0.6 GB of
-- the machine left and 1.9 GB in swap. Starting the compiler with its
-- compacting collector (+RTS -c) changed nothing, so those gigabytes are
-- what it holds, not a collection's second copy. A new module with a splice
-- in core costs the same again: put a binding in a module that already has
-- one, or in another package. CI gives the job more swap
-- (.github/workflows/build.yml).

with-compiler: javascript-unknown-ghcjs-ghc-9.12.2
with-hc-pkg: javascript-unknown-ghcjs-ghc-pkg-9.12.2
