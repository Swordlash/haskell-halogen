import: cabal.project

allow-newer:
  *:base, *:template-haskell, protolude:ghc-prim

-- Hackage as of master's last green JS build: constraints 0.13.4, out
-- since, exports a name spelled forall, which the JavaScript GHC (9.12)
-- does not parse (and pinning constraints alone drags aeson back to 0.8).
index-state: 2026-09-27T00:00:00Z

-- -ddisable-js-c-sources has to apply to every package, not just the library
-- that declares js-sources: the executables are separate packages here, and
-- their link step is what invokes emcc.
package *
  ghc-options: -O2 -fexpose-all-unfoldings -fspecialise-aggressively -ddisable-js-c-sources

-- What compiling a package costs on this backend. The compiler keeps memory
-- for every top-level splice it runs, until the package ends. Small
-- libraries, each compiled by its own compiler with +RTS -s on a CI runner:
--
--   12 modules, no splice                           36 MiB
--   12 modules, one empty splice each             2122 MiB
--   1 module with 12 splices, 11 plain modules    2035 MiB
--   24 modules, one splice each                   3390 MiB
--
-- So the cost is per splice: about 110 MiB each, plus about 800 MiB once.
-- It does not depend on the module the splice is in, or on what it runs.
-- Core had 103 splices. They took the compiler to 14.4 GB on the runner's
-- 16, and into swap. Now it has 39, one per module. The compacting
-- collector (+RTS -c) changed nothing, so the compiler holds that memory.
--
-- The rule: one splice per module. A module runs all its generators in one
-- splice, through Halogen.JSBits.declarations. A new binding goes into the
-- module's splice, not into a splice of its own. CI gives the job more swap
-- (.github/workflows/build.yml).
--
-- Two builds at a time. Once core is compiled, cabal would build and link as
-- many packages and test suites at once as the machine has cores. On a CI
-- runner with four, a passing run had 12.4 GB in use, with one compiler at
-- 6.7 GB, and other runs took the runner down. Two at a time stay under what
-- the runner has.
jobs: 2

with-compiler: javascript-unknown-ghcjs-ghc-9.12.2
with-hc-pkg: javascript-unknown-ghcjs-ghc-pkg-9.12.2
