cabal-version:      3.4
name:               haskell-halogen-th
version:            0.1.0.0
synopsis:           HTML and CSS quasi-quoters for haskell-halogen and Clay
description:
  Two quasi-quoters: @hh@ turns HTML with Haskell inside into a Halogen
  @HTML w i@ (elements, properties and event handlers as the typed functions
  of "Halogen.HTML"), and @clay@ turns CSS with Haskell inside into Clay's
  @Css@. Both take @{{ expression }}@ for values, and
  @{% if %}@, @{% for %}@ and @{% let %}@ for control; the expressions are
  parsed by the parser of the compiling GHC itself (its @ghc@ library),
  with the extensions of the module they are in.
homepage:           https://github.com/Swordlash/haskell-halogen
license:            Apache-2.0
license-file:       LICENSE
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web, Template Haskell
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

common defaults
    default-language: GHC2021
    ghc-options: -Wall -Wextra -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates -Wredundant-constraints -Wmissing-home-modules -Wunused-packages
    default-extensions:
        OverloadedStrings
        OverloadedRecordDot
        LambdaCase
        StrictData

library
    import:           defaults
    hs-source-dirs:   src
    ghc-options:      -Wmissing-export-lists
    exposed-modules:  Halogen.TH
                      Halogen.TH.Html
                      Halogen.TH.Clay
                      Halogen.TH.Css
                      Halogen.TH.Haskell
                      Halogen.TH.Template
                      Halogen.TH.Check
    other-modules:    Halogen.TH.Html.Names
                      Halogen.TH.Html.Children
                      Halogen.TH.Svg.Names
    build-depends:
        base >= 4.20 && < 5,
        text >= 2.0,
        bytestring,
        containers,
        template-haskell >= 2.22,
        tagsoup >= 0.14,
        megaparsec >= 9,
        css-syntax >= 0.1,
        clay >= 0.16,
        row-types,
        -- The compiler's own library, for its parser: a quote's Haskell
        -- is read by the GHC that compiles the module around it.
        ghc >= 9.10 && < 9.15,
        haskell-halogen-core

    -- The library builds with the JavaScript backend (the CPP for GHC 9.10
    -- and 9.12 in Halogen.TH.Haskell is there for that backend's 9.12 and
    -- for native 9.10 and 9.12), but a quote does not: that backend runs Template
    -- Haskell in node, after linking the splice's dependencies into
    -- JavaScript inside the compiler, and here that is the ghc library,
    -- 1.7 GB of objects. examples/th's module of five quotes took two
    -- minutes and 12.7 GB, and the tests' module of 45 was killed past
    -- 17 GB. So the package is for native and WebAssembly builds only.
    if arch(javascript)
        buildable: False

test-suite th-test
    import:           defaults
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Test.hs
    other-modules:    Test.Html
                      Test.Check
                      Test.Clay
                      Test.Haskell
                      Test.Property
                      Test.Render
    default-extensions: QuasiQuotes
    build-depends:
        base,
        text,
        containers,
        hspec,
        QuickCheck,
        template-haskell,
        clay,
        row-types,
        haskell-halogen-core,
        haskell-halogen-th

    if arch(javascript)
        buildable: False

source-repository head
    type:     git
    location: https://github.com/Swordlash/haskell-halogen.git
    subdir:   th
