  hs-source-dirs:  no-splice
  ghc-options:     "+RTS" "-sno-splice.rts" "-RTS"
  exposed-modules:
    NoSplice.M00
    NoSplice.M01
    NoSplice.M02
    NoSplice.M03
    NoSplice.M04
