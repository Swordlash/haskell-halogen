cabal-version:      3.0
name:               halogen-example-hooks
version:            0.1.0.0
synopsis:           haskell-halogen-hooks example app
license:            Apache-2.0
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web

common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      RankNTypes
      GeneralizedNewtypeDeriving
      MultiParamTypeClasses
      FunctionalDependencies
      FlexibleContexts
      FlexibleInstances
      UndecidableInstances
      GADTs
      DeriveFunctor
      DerivingStrategies
      NoImplicitPrelude
      KindSignatures
      DataKinds
      OverloadedStrings
      TypeOperators
      LambdaCase
      TypeFamilies
      OverloadedRecordDot
      RecordWildCards
      NamedFieldPuns
      DuplicateRecordFields
      PartialTypeSignatures
      DefaultSignatures
      StandaloneKindSignatures
      NoFieldSelectors
      DerivingVia
      CPP
      QualifiedDo
      StrictData
      RequiredTypeArguments
      ExplicitNamespaces


library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Example.Hooks
  build-depends:
      protolude,
      clay >= 0.16.0,
      containers,
      row-types,
      text,
      unliftio,
      haskell-halogen-core,
      haskell-halogen-hooks

executable halogen-example-hooks
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   .
  build-depends:
      protolude,
      haskell-halogen-core,
      halogen-example-hooks

  if arch(wasm32)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"
