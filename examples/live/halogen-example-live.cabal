cabal-version:      3.0
name:               halogen-example-live
version:            0.1.0.0
synopsis:           haskell-halogen-remote example: a shared board over a wire, served natively or looped back in a page
license:            Apache-2.0
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web

flag interactive
  description: Build the example for browser GHCi (toolchain/dev.sh)
  default:     False
  manual:      True

common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      RankNTypes
      GeneralizedNewtypeDeriving
      MultiParamTypeClasses
      FunctionalDependencies
      FlexibleContexts
      FlexibleInstances
      UndecidableInstances
      GADTs
      DeriveFunctor
      DerivingStrategies
      NoImplicitPrelude
      KindSignatures
      DataKinds
      OverloadedStrings
      TypeOperators
      LambdaCase
      TypeFamilies
      OverloadedRecordDot
      RecordWildCards
      NamedFieldPuns
      DuplicateRecordFields
      PartialTypeSignatures
      DefaultSignatures
      StandaloneKindSignatures
      NoFieldSelectors
      DerivingVia
      CPP
      StrictData
      RequiredTypeArguments
      ExplicitNamespaces

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Example.Live
    Example.Live.Wire
  build-depends:
      protolude,
      row-types,
      text,
      haskell-halogen-core,
      haskell-halogen-remote

-- The loopback, in a page: npm run serve-wasm -- live.
executable halogen-example-live
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   .
  build-depends:
      protolude,
      haskell-halogen-core

  -- Browser GHCi (toolchain/dev.sh) reloads only the modules of the target it
  -- loaded, so there the example's modules are compiled into the executable
  -- rather than taken from the library, where edits would go unnoticed.
  if flag(interactive)
    hs-source-dirs: src
    other-modules:
      Example.Live
      Example.Live.Wire
    build-depends:
        row-types,
        text,
        haskell-halogen-remote
  -- Natively the page has nothing to mount (Main says so), and needs none
  -- of the example's modules.
  elif arch(wasm32) || arch(javascript)
    build-depends:
        halogen-example-live

  if arch(wasm32) && !flag(interactive)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"

  if flag(interactive)
    cpp-options: -DINTERACTIVE

-- The board served to every page that opens it, natively, over WebSockets:
-- cabal run halogen-example-live-server --builddir=dist-newstyle/native,
-- from the repository's root.
executable halogen-example-live-server
  import:           shared
  main-is:          Server.hs
  hs-source-dirs:   .
  ghc-options:      -threaded
  build-depends:
      base,
      protolude,
      haskell-halogen-remote,
      halogen-example-live
  if arch(wasm32) || arch(javascript)
    buildable: False
