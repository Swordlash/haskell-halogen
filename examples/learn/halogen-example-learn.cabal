cabal-version:      3.0
name:               halogen-example-learn
version:            0.1.0.0
synopsis:           A haskell-halogen tutorial whose code compiles in the browser
license:            Apache-2.0
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web
tested-with:        GHC == 9.10.3, GHC == 9.12.4, GHC == 9.14.1

-- The lessons are read at compile time (Learn.Lessons), and so is the
-- bindings' JavaScript (Learn.Browser); listing them here is what makes
-- cabal rebuild the package when one changes (a glob's directory part must
-- be **: a * there matches nothing). A new lesson is added to
-- lessons/index.txt, which is what makes cabal notice it: a new file that
-- matches a glob does not.
extra-source-files:
    jsbits/*.js
    lessons/index.txt
    lessons/**/*.md
    lessons/**/*.hs
    playground-test/programs/*.hs

flag interactive
  description: Build the example for browser GHCi (toolchain/dev.sh)
  default:     False
  manual:      True

common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      BlockArguments
      DataKinds
      DerivingStrategies
      DuplicateRecordFields
      ExplicitNamespaces
      LambdaCase
      NamedFieldPuns
      NoFieldSelectors
      NoImplicitPrelude
      OverloadedRecordDot
      OverloadedStrings
      RequiredTypeArguments
      StrictData
      TypeOperators

library
  import:           shared
  hs-source-dirs:   src
  build-depends:
      aeson,
      base,
      bytestring,
      directory,
      filepath,
      protolude,
      row-types,
      template-haskell,
      text,
      unliftio,
      haskell-halogen-core,
      haskell-halogen-jsbits,
      haskell-halogen-router
  exposed-modules:
      Learn.App
      Learn.Browser
      Learn.Diagnostics
      Learn.Lesson
      Learn.Lessons
      Learn.Lessons.Embed
      Learn.Markdown
      Learn.Playground
      Learn.Route
      Learn.Types
      Learn.View

  if arch(javascript)
    js-sources: jsbits/learn.js

executable halogen-example-learn
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   .
  build-depends:    protolude

  -- The tutorial only runs in a browser: on a host GHC, Main says so.
  if arch(wasm32) || arch(javascript)
    build-depends:
        haskell-halogen-core,
        haskell-halogen-router

    -- Browser GHCi (toolchain/dev.sh) reloads only the modules of the target
    -- it loaded, so there the tutorial's modules are compiled into the
    -- executable rather than taken from the library, where edits would go
    -- unnoticed.
    if flag(interactive)
      hs-source-dirs: src
      other-modules:
          Learn.App
          Learn.Browser
          Learn.Diagnostics
          Learn.Lesson
          Learn.Lessons
          Learn.Lessons.Embed
          Learn.Markdown
          Learn.Playground
          Learn.Route
          Learn.Types
          Learn.View
      build-depends:
          aeson,
          base,
          bytestring,
          directory,
          filepath,
          row-types,
          template-haskell,
          text,
          unliftio,
          haskell-halogen-jsbits
    else
      build-depends: halogen-example-learn

  -- The wasm program is a reactor, which the page starts through its
  -- hs_start export. GHCi loads the program's modules and runs main itself,
  -- so the interactive build is an ordinary program, and Main leaves the
  -- export out when INTERACTIVE is defined.
  if arch(wasm32) && !flag(interactive)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"

  if flag(interactive)
    cpp-options: -DINTERACTIVE

-- The Markdown reader, which runs at compile time and reads the same on
-- every backend: tested natively only.
test-suite Halogen-learn-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Test.hs
  hs-source-dirs:   test

  if arch(wasm32) || arch(javascript)
    buildable: False
  else
    build-depends:
        hspec >= 2,
        protolude,
        haskell-halogen-router,
        halogen-example-learn

-- The playground (learn/) on the rootfs in Chromium, driven from outside the
-- page by haskell-halogen-playwright: GHC loading in the page, compiling a
-- program and mounting it, with a program for every layer of the rootfs
-- (playground-test/programs/). A native program that tests what npm run
-- build-rootfs built (dist-newstyle/wasm/learn, or the directory
-- LEARN_ROOTFS_DIR names), so it builds nothing for the browser and depends
-- on none of the tutorial's code. Its examples are pending without the
-- rootfs, unless HALOGEN_EXAMPLE_REQUIRED=1 (npm run test-playground sets it).
test-suite halogen-example-learn-playground-test
  type:             exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs:   playground-test
  main-is:          Playground.hs
  ghc-options:      -Wall -Wextra -Wcompat -Wredundant-constraints -Wunused-packages -threaded
  default-extensions:
      DuplicateRecordFields
      LambdaCase
      NoFieldSelectors
      OverloadedRecordDot
      OverloadedStrings
      StrictData
  if arch(wasm32) || arch(javascript)
    buildable: False
  else
    build-depends:
        base,
        aeson,
        bytestring,
        containers,
        directory,
        filepath,
        http-types,
        text,
        wai,
        warp,
        haskell-halogen-playwright

-- The tutorial as Pages deploys it (dist-newstyle/wasm/public/learn, the
-- rootfs in it), in Chromium, driven from outside the page by
-- haskell-halogen-playwright: every page prerendered and adopted with
-- nothing repaired, the compiler loading in the page, every lesson's
-- Start.hs and Solution.hs compiling there, the playground, Source, the
-- live check, a second visit from the cache, a narrow screen and loads
-- that fail. npm run test-learn runs it, and the deploy is gated on it. A
-- native program that builds nothing for the browser and depends on none of
-- the tutorial's code; it reads the lessons and the playground's template
-- from the package's directory. Its examples are pending without the built
-- tree, unless HALOGEN_EXAMPLE_REQUIRED=1 (npm run test-learn sets it).
test-suite halogen-example-learn-browser-test
  type:             exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs:   browser-test
  main-is:          Browser.hs
  other-modules:
      Tutorial.Later
      Tutorial.Lessons
      Tutorial.Loading
      Tutorial.Pages
      Tutorial.Site
      Tutorial.Walk
  ghc-options:      -Wall -Wextra -Wcompat -Wredundant-constraints -Wunused-packages -threaded
  default-extensions:
      DuplicateRecordFields
      LambdaCase
      NoFieldSelectors
      OverloadedRecordDot
      OverloadedStrings
      StrictData
  if arch(wasm32) || arch(javascript)
    buildable: False
  else
    build-depends:
        base,
        aeson,
        async,
        bytestring,
        containers,
        directory,
        filepath,
        HUnit,
        stm,
        text,
        vector,
        haskell-halogen-playwright

-- Every route's page, with the tutorial already rendered into it, written
-- natively at build time (toolchain/build-wasm.sh runs it). Only a host GHC
-- renders to HTML, so there is nothing to build on the browser backends.
executable halogen-example-learn-prerender
  import:           shared
  main-is:          Prerender.hs
  hs-source-dirs:   .

  if arch(wasm32) || arch(javascript)
    buildable: False
  else
    build-depends:
        base,
        bytestring,
        directory,
        filepath,
        protolude,
        text,
        haskell-halogen-core,
        haskell-halogen-router,
        halogen-example-learn
