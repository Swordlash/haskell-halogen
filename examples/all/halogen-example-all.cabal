cabal-version:      3.0
name:               halogen-example-all
version:            0.1.0.0
synopsis:           Every haskell-halogen example in one single-page app
license:            Apache-2.0
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web

executable halogen-example-all
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      CPP
      DataKinds
      DerivingStrategies
      DuplicateRecordFields
      ExplicitNamespaces
      LambdaCase
      NamedFieldPuns
      NoImplicitPrelude
      OverloadedRecordDot
      OverloadedStrings
      RequiredTypeArguments
      TypeOperators

  main-is:          Main.hs
  hs-source-dirs:   .

  build-depends:    protolude

  -- The gallery only runs in a browser: on a host GHC, Main says so.
  if arch(wasm32) || arch(javascript)
    other-modules: Gallery
    build-depends:
        clay >= 0.16.0,
        row-types,
        text,
        haskell-halogen-core,
        halogen-example-hooks,
        halogen-example-material,
        halogen-example-pixi,
        halogen-example-th,
        halogen-example-vanilla

  if arch(wasm32)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"
