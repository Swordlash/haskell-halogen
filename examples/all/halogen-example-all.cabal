cabal-version:      3.0
name:               halogen-example-all
version:            0.1.0.0
synopsis:           Every haskell-halogen example in one single-page app
license:            Apache-2.0
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web

flag interactive
  description: Build the example for browser GHCi (toolchain/dev.sh)
  default:     False
  manual:      True

common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      CPP
      DataKinds
      DerivingStrategies
      DuplicateRecordFields
      ExplicitNamespaces
      LambdaCase
      NamedFieldPuns
      NoImplicitPrelude
      OverloadedRecordDot
      OverloadedStrings
      RequiredTypeArguments
      TypeOperators

executable halogen-example-all
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   .

  build-depends:    protolude

  -- The gallery only runs in a browser: on a host GHC, Main says so.
  if arch(wasm32) || arch(javascript)
    other-modules:
        Gallery
        Gallery.Shell
    build-depends:
        clay >= 0.16.0,
        row-types,
        text,
        haskell-halogen-core,
        haskell-halogen-router,
        halogen-example-hooks,
        halogen-example-material,
        halogen-example-pixi,
        halogen-example-th,
        halogen-example-vanilla

  -- The wasm program is a reactor, which the page starts through its
  -- hs_start export. GHCi loads the program's modules and runs main itself,
  -- so the interactive build is an ordinary program, and Main leaves the
  -- export out when INTERACTIVE is defined.
  if arch(wasm32) && !flag(interactive)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"

  -- Unlike the other examples, the gallery needs no sources of its own for
  -- browser GHCi (toolchain/dev.sh): its modules are the executable's
  -- already, so GHCi reloads them, and the examples it mounts are libraries
  -- to it, which GHCi is restarted to rebuild.
  if flag(interactive)
    cpp-options: -DINTERACTIVE

-- Every route's page, with the gallery's shell already rendered into it,
-- written natively at build time (toolchain/build-wasm.sh runs it). Only a
-- host GHC renders to HTML, so there is nothing to build on the browser
-- backends.
executable halogen-example-all-prerender
  import:           shared
  main-is:          Prerender.hs
  hs-source-dirs:   .

  if arch(wasm32) || arch(javascript)
    buildable: False
  else
    other-modules: Gallery.Shell
    build-depends:
        base,
        bytestring,
        clay >= 0.16.0,
        directory,
        filepath,
        protolude,
        row-types,
        text,
        haskell-halogen-core,
        haskell-halogen-router
