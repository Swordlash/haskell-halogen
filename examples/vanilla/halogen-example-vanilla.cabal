cabal-version:      3.0
name:               halogen-example-vanilla
version:            0.1.0.0
synopsis:           haskell-halogen-core example app
license:            Apache-2.0
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web

flag wasi
  description: Build the prerenderer as a standalone WASI command.
  default: False
  manual: True

flag interactive
  description: Build the example for browser GHCi (toolchain/dev.sh)
  default:     False
  manual:      True

common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      RankNTypes
      GeneralizedNewtypeDeriving
      MultiParamTypeClasses
      FunctionalDependencies
      FlexibleContexts
      FlexibleInstances
      UndecidableInstances
      GADTs
      DeriveFunctor
      DerivingStrategies
      NoImplicitPrelude
      KindSignatures
      DataKinds
      OverloadedStrings
      TypeOperators
      LambdaCase
      TypeFamilies
      OverloadedRecordDot
      RecordWildCards
      NamedFieldPuns
      DuplicateRecordFields
      PartialTypeSignatures
      DefaultSignatures
      StandaloneKindSignatures
      NoFieldSelectors
      DerivingVia
      CPP
      StrictData
      RequiredTypeArguments
      ExplicitNamespaces


library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Example.Vanilla
  build-depends:
      protolude,
      clay >= 0.16.0,
      kan-extensions,
      row-types,
      unliftio,
      haskell-halogen-core

executable halogen-example-vanilla
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   .
  build-depends:
      protolude,
      haskell-halogen-core

  -- Browser GHCi (toolchain/dev.sh) reloads only the modules of the target it
  -- loaded, so there the example's module is compiled into the executable
  -- rather than taken from the library, where edits would go unnoticed.
  if flag(interactive)
    hs-source-dirs: src
    other-modules:  Example.Vanilla
    build-depends:
        clay >= 0.16.0,
        kan-extensions,
        row-types,
        unliftio
  else
    build-depends:  halogen-example-vanilla

  -- The wasm program is a reactor, which the page starts through its
  -- hs_start export. GHCi loads the program's modules and runs main itself,
  -- so the interactive build is an ordinary program, and Main leaves the
  -- export out when INTERACTIVE is defined.
  if arch(wasm32) && !flag(interactive)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"

  if flag(interactive)
    cpp-options: -DINTERACTIVE

-- The page with the component already rendered into it, written natively at
-- build time (toolchain/build-wasm.sh runs it). Only a host GHC renders to
-- HTML, so there is nothing to build on the browser backends.
executable halogen-example-vanilla-prerender
  import:           shared
  main-is:          Prerender.hs
  hs-source-dirs:   .

  if (arch(wasm32) || arch(javascript)) && !flag(wasi)
    buildable: False
  else
    build-depends:
        bytestring,
        filepath,
        protolude,
        haskell-halogen-core,
        halogen-example-vanilla
