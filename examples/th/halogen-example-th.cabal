cabal-version:      3.0
name:               halogen-example-th
version:            0.1.0.0
synopsis:           haskell-halogen-th example app: HTML and CSS quoted
license:            Apache-2.0
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web

flag interactive
  description: Build the example for browser GHCi (toolchain/dev.sh)
  default:     False
  manual:      True

common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      CPP
      DataKinds
      DerivingStrategies
      DuplicateRecordFields
      LambdaCase
      NamedFieldPuns
      NoImplicitPrelude
      OverloadedRecordDot
      OverloadedStrings
      QuasiQuotes
      StrictData
      TypeOperators


library
  import:           shared
  exposed-modules:  Example.Quotes
  build-depends:
      protolude,
      row-types,
      unliftio,
      haskell-halogen-core
  -- haskell-halogen-th builds natively and for WebAssembly, not with the
  -- JavaScript backend; there the example is a note saying so.
  if arch(javascript)
    hs-source-dirs: src-js
  else
    hs-source-dirs: src
    build-depends:
        clay >= 0.16.0,
        text,
        haskell-halogen-th
    -- Natively, the plugin reports an error in a quote where it is; a
    -- plugin cannot run in the WebAssembly cross compiler.
    if !arch(wasm32)
      build-depends: haskell-halogen-th-plugin
      ghc-options:   -fplugin=Halogen.TH.Plugin

executable halogen-example-th
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   .
  build-depends:
      protolude,
      haskell-halogen-core

  -- Browser GHCi (toolchain/dev.sh) reloads only the modules of the target it
  -- loaded, so there the example's module is compiled into the executable
  -- rather than taken from the library, where edits would go unnoticed.
  -- Browser GHCi runs wasm, so the sources are src/, not the JavaScript
  -- backend's note in src-js/.
  if flag(interactive)
    hs-source-dirs: src
    other-modules:  Example.Quotes
    build-depends:
        clay >= 0.16.0,
        row-types,
        text,
        unliftio,
        haskell-halogen-th
  -- The example itself only runs in a browser: on a host GHC, Main says so.
  elif arch(wasm32) || arch(javascript)
    build-depends:  halogen-example-th

  -- The wasm program is a reactor, which the page starts through its
  -- hs_start export. GHCi loads the program's modules and runs main itself,
  -- so the interactive build is an ordinary program, and Main leaves the
  -- export out when INTERACTIVE is defined.
  if arch(wasm32) && !flag(interactive)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"

  if flag(interactive)
    cpp-options: -DINTERACTIVE
