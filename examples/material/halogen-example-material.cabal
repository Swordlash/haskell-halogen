cabal-version:      3.4
name:               halogen-example-material
version:            0.1.0.0
synopsis:           haskell-halogen-material example app
license:            Apache-2.0
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web
build-type:         Simple

flag interactive
    description: Build the example for browser GHCi (toolchain/dev.sh)
    default:     False
    manual:      True

common shared
    default-language: GHC2024
    ghc-options: -Wall -Wextra -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates -Wredundant-constraints -Wmissing-home-modules -Wmissing-export-lists -Wno-ambiguous-fields -Wunused-packages
    default-extensions:
        OverloadedStrings
        CPP
        StrictData
        DuplicateRecordFields
        NoFieldSelectors
        OverloadedRecordDot
        RecordWildCards
        NamedFieldPuns
        NoImplicitPrelude
        RequiredTypeArguments
        TypeAbstractions

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  Example.Material
    build-depends:
        protolude,
        clay,
        row-types,
        haskell-halogen-core,
        haskell-halogen-material

executable halogen-example-material
    import:           shared
    main-is:          Main.hs
    hs-source-dirs:   .
    build-depends:
        protolude,
        haskell-halogen-core

    -- Browser GHCi (toolchain/dev.sh) reloads only the modules of the target it
    -- loaded, so there the example's module is compiled into the executable
    -- rather than taken from the library, where edits would go unnoticed.
    if flag(interactive)
        hs-source-dirs: src
        other-modules:  Example.Material
        build-depends:
            clay,
            row-types,
            haskell-halogen-material
    -- The example itself only runs in a browser: on a host GHC, Main says so.
    elif arch(wasm32) || arch(javascript)
        build-depends:  halogen-example-material

    -- The wasm program is a reactor, which the page starts through its
    -- hs_start export. GHCi loads the program's modules and runs main itself,
    -- so the interactive build is an ordinary program, and Main leaves the
    -- export out when INTERACTIVE is defined.
    if arch(wasm32) && !flag(interactive)
        ghc-options:
            -no-hs-main
            -optl-mexec-model=reactor
            "-optl-Wl,--export=hs_start"

    if flag(interactive)
        cpp-options: -DINTERACTIVE
