cabal-version:      3.0
name:               halogen-example-pixi
version:            0.1.0.0
synopsis:           haskell-halogen-pixi canvas example app
license:            Apache-2.0
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web

flag interactive
  description: Build the example for browser GHCi (toolchain/dev.sh)
  default:     False
  manual:      True

common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      RankNTypes
      GeneralizedNewtypeDeriving
      MultiParamTypeClasses
      FunctionalDependencies
      FlexibleContexts
      FlexibleInstances
      UndecidableInstances
      GADTs
      DeriveFunctor
      DerivingStrategies
      NoImplicitPrelude
      KindSignatures
      DataKinds
      OverloadedStrings
      TypeOperators
      LambdaCase
      TypeFamilies
      OverloadedRecordDot
      RecordWildCards
      NamedFieldPuns
      DuplicateRecordFields
      PartialTypeSignatures
      DefaultSignatures
      StandaloneKindSignatures
      NoFieldSelectors
      DerivingVia
      CPP
      StrictData
      RequiredTypeArguments
      ExplicitNamespaces


library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Example.Pixi
  build-depends:
      clay >= 0.16.0,
      protolude,
      row-types,
      haskell-halogen-core,
      haskell-halogen-pixi

executable halogen-example-pixi
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   .
  build-depends:    protolude

  -- Browser GHCi (toolchain/dev.sh) reloads only the modules of the target it
  -- loaded, so there the example's module is compiled into the executable
  -- rather than taken from the library, where edits would go unnoticed.
  if flag(interactive)
    hs-source-dirs: src
    other-modules:  Example.Pixi
    build-depends:
        clay >= 0.16.0,
        row-types,
        haskell-halogen-core,
        haskell-halogen-pixi
  -- The example itself only runs in a browser: on a host GHC, Main says so.
  elif arch(wasm32) || arch(javascript)
    build-depends:
        haskell-halogen-core,
        halogen-example-pixi

  -- The wasm program is a reactor, which the page starts through its
  -- hs_start export. GHCi loads the program's modules and runs main itself,
  -- so the interactive build is an ordinary program, and Main leaves the
  -- export out when INTERACTIVE is defined.
  if arch(wasm32) && !flag(interactive)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"

  if flag(interactive)
    cpp-options: -DINTERACTIVE
