cabal-version:      3.4
name:               haskell-halogen-th-plugin
version:            0.1.0.0
synopsis:           Errors in hh and clay quotes at their place in the file
description:
  A GHC plugin for haskell-halogen-th. GHC reports an error inside an
  @[hh| … |]@, @[hhs| … |]@ or @[clay| … |]@ quote at the quote; with
  @-fplugin=Halogen.TH.Plugin@ each is reported at its line and column as
  the module is parsed, in the compiler's output and in any language
  server built on it.
homepage:           https://github.com/Swordlash/haskell-halogen
license:            Apache-2.0
license-file:       LICENSE
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web, Development
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

common defaults
    default-language: GHC2021
    ghc-options: -Wall -Wextra -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates -Wredundant-constraints -Wmissing-home-modules -Wunused-packages
    default-extensions:
        OverloadedStrings
        LambdaCase
        StrictData

library
    import:           defaults
    hs-source-dirs:   src
    ghc-options:      -Wmissing-export-lists
    exposed-modules:  Halogen.TH.Plugin
    build-depends:
        base >= 4.20 && < 5,
        containers,
        ghc >= 9.12 && < 9.15,
        haskell-halogen-th,
        syb >= 0.7,
        template-haskell,
        text >= 2.0

    -- A plugin runs inside the compiler, so there is none for the targets
    -- of a cross compiler.
    if arch(javascript) || arch(wasm32)
        buildable: False

-- The th package's own tests, compiled with the plugin: every quote in them
-- is expanded by the plugin instead of run by its quoter, and must build
-- the same HTML and CSS. test/parity links to th/test (a test suite of th
-- itself could not depend on this package: cabal's solver sees a cycle).
test-suite parity-test
    import:           defaults
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test/parity
    main-is:          Test.hs
    other-modules:    Test.Html
                      Test.Check
                      Test.Clay
                      Test.Haskell
                      Test.Property
                      Test.Render
    default-extensions: QuasiQuotes
                        OverloadedRecordDot
    ghc-options:      -fplugin=Halogen.TH.Plugin
    build-depends:
        base,
        text,
        containers,
        hspec,
        QuickCheck,
        template-haskell,
        clay,
        row-types,
        haskell-halogen-core,
        haskell-halogen-th,
        haskell-halogen-th-plugin

    if arch(javascript) || arch(wasm32)
        buildable: False
