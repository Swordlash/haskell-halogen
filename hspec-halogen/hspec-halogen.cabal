cabal-version:      3.4
name:               hspec-halogen
version:            0.1.0.0
synopsis:           Test haskell-halogen components in a real browser with hspec
description:
  Mount a component into a real page, find its elements, click and type into
  them with real input, and check the result with hspec. A suite built with
  this runs in headless Chromium on the WebAssembly backend, run by this
  package's hspec-halogen executable as cabal's test wrapper; see
  "Test.Hspec.Halogen" and the README. It builds on every
  backend, so a suite type-checks natively, but only runs on WebAssembly.
homepage:           https://github.com/Swordlash/haskell-halogen
license:            Apache-2.0
license-file:       LICENSE
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web, Testing
build-type:         Simple
extra-doc-files:    CHANGELOG.md
extra-source-files: js/runner.mjs
                    js/open.mjs

library
    default-language: GHC2024
    hs-source-dirs:   src
    ghc-options: -Wall -Wextra -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates -Wredundant-constraints -Wmissing-home-modules -Wmissing-export-lists
    default-extensions:
        OverloadedStrings
        OverloadedRecordDot
        NoImplicitPrelude
        RequiredTypeArguments
        DuplicateRecordFields
    exposed-modules:  Test.Hspec.Halogen
    other-modules:    Test.Hspec.Halogen.Internal.Monad
                      Test.Hspec.Halogen.Internal.Page
    build-depends:
        base,
        protolude,
        text,
        HUnit,
        hspec,
        exceptions,
        unliftio,
        haskell-halogen-core

    -- The page is driven through the WebAssembly backend's JSFFI; elsewhere
    -- the functions that would drive it panic (see Internal.Page).
    if arch(wasm32)
        other-modules: Test.Hspec.Halogen.Internal.Wasm
        build-depends: ghc-experimental

-- The host side, run with the host compiler: cabal's test wrapper for wasm
-- suites, and the opener for a suite in browser GHCi. It carries the
-- JavaScript that drives Playwright, so a project using the library writes
-- none.
executable hspec-halogen
    default-language: GHC2024
    hs-source-dirs:   app
    main-is:          Main.hs
    other-modules:    Embed
    ghc-options: -Wall -Wextra -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates -Wredundant-constraints -Wmissing-home-modules -Wmissing-export-lists
    build-depends:
        base,
        filepath,
        process,
        temporary,
        template-haskell

    if arch(wasm32) || arch(javascript)
        buildable: False

source-repository head
  type:     git
  location: https://github.com/Swordlash/haskell-halogen.git
  subdir:   hspec-halogen
